# Environment Configuration Example for Next.js 15
# Copy this file to .env.local for local development

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# Supabase Configuration
# For local development: http://localhost:8075
# For production: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://akwhptzlqgtlcpzvcnjl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Environment Identification
NEXT_PUBLIC_ENVIRONMENT=production  # Options: local, development, staging, production
NEXT_PUBLIC_ENV_NAME=Production

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=5000        # Milliseconds
NEXT_PUBLIC_API_RETRY_COUNT=3       # Number of retries on failure

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false
NEXT_PUBLIC_SHOW_ENV_INDICATOR=false   # Shows environment badge in UI

# Asset Storage Configuration
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=directus-uploads
NEXT_PUBLIC_ASSET_BASE_URL=https://akwhptzlqgtlcpzvcnjl.supabase.co/storage/v1/object/public

# GraphQL Configuration (auto-constructed if not provided)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://akwhptzlqgtlcpzvcnjl.supabase.co/graphql/v1

# Cache Configuration
NEXT_PUBLIC_CACHE_DURATION=300000   # 5 minutes in milliseconds

# Development Tools
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_LOG_API_CALLS=false

# ===========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ===========================================
#
# For local development with Supabase running locally:
# 1. Install Supabase CLI: npm install -g supabase
# 2. Start local Supabase: supabase start
# 3. Copy this file to .env.local
# 4. Update NEXT_PUBLIC_SUPABASE_URL to http://localhost:8075
# 5. Use the local anon key provided by Supabase CLI
#
# Default local configuration:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8075
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
